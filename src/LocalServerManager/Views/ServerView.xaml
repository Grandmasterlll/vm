<UserControl x:Class="LocalServerManager.Views.ServerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:LocalServerManager.ViewModels"
        mc:Ignorable="d" 
        d:DesignHeight="600" d:DesignWidth="1000"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Статус сервера -->
        <Border Grid.Row="0" 
                Padding="24"
                Background="{DynamicResource MaterialDesignCardBackground}"
                CornerRadius="8"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Индикатор статуса -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Circle" 
                                             Width="64" Height="64"
                                             Foreground="#FF4CAF50"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ServerStatusText}" 
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Foreground="{DynamicResource MaterialDesignBody}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Информация -->
                <StackPanel Grid.Column="1" Margin="32,0,0,0">
                    <TextBlock Text="Development Server" 
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <materialDesign:PackIcon Kind="Network" 
                                                 Width="16" Height="16"
                                                 Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="http://127.0.0.1:8000" 
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   Margin="0,0,16,0"/>
                        <materialDesign:PackIcon Kind="Identifier" 
                                                 Width="16" Height="16"
                                                 Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ProcessId, StringFormat='PID: {0}'}" 
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Кнопки управления -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding StartServerCommand}"
                            Content="Запустить" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#FF4CAF50"
                            Padding="24,12"
                            Margin="0,0,8,0"/>
                    <Button Command="{Binding StopServerCommand}"
                            Content="Остановить" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#FFF44336"
                            Padding="24,12"/>
                    <Button Command="{Binding RestartServerCommand}"
                            Content="Перезапустить" 
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Padding="24,12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Логи -->
        <TextBlock Grid.Row="1" 
                   Text="Логи сервера" 
                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                   Foreground="{DynamicResource MaterialDesignBody}"
                   Margin="0,0,0,8"/>

        <Border Grid.Row="2" 
                Background="#FF1E1E1E"
                CornerRadius="4"
                Padding="16">
            <ScrollViewer materialDesign:ScrollViewerAssist.IsAutoHideEnabled="True"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Logs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" 
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Foreground="#FF90EE90"
                                       TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Статус бар -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    Margin="0,16,0,0">
            <materialDesign:PackIcon Kind="ClockOutline" 
                                     Width="16" Height="16"
                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                     VerticalAlignment="Center"/>
            <TextBlock Text="Готов к работе" 
                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       Margin="4,0,16,0"/>
            <materialDesign:PackIcon Kind="CheckCircle" 
                                     Width="16" Height="16"
                                     Foreground="#FF4CAF50"
                                     VerticalAlignment="Center"/>
            <TextBlock Text="Статус: OK" 
                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
        </StackPanel>
    </Grid>
</UserControl>